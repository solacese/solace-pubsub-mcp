# Solace PubSub MCP - Configuration
# Copy to .env and adjust values for your environment.

# Broker connection
SOLACE_HOST=tcp://localhost:55555
SOLACE_VPN=default
SOLACE_USERNAME=default
SOLACE_PASSWORD=default

# TLS (set host to tcps://... when enabled)
SOLACE_TLS_ENABLED=false
# SOLACE_TLS_TRUST_STORE_PATH=/path/to/truststore.jks
# SOLACE_TLS_TRUST_STORE_PASSWORD=changeit

# Reconnect
SOLACE_RECONNECT_ENABLED=true
SOLACE_RECONNECT_RETRIES=-1
SOLACE_RECONNECT_INITIAL_DELAY_MS=1000
SOLACE_RECONNECT_MAX_DELAY_MS=30000

# Limits
SOLACE_MAX_PAYLOAD_BYTES=1048576
SOLACE_MAX_ACTIVE_SUBSCRIPTIONS=50
SOLACE_MAX_BUFFER_PER_SUBSCRIPTION=1000
SOLACE_REQUEST_TIMEOUT_MS=30000

# Topic policy
SOLACE_TOPIC_ALLOW_LIST=
SOLACE_TOPIC_DENY_LIST=
SOLACE_ALLOW_WILDCARD_SUBSCRIPTIONS=true
SOLACE_ALLOW_FULL_WILDCARD=false

# Observability
SOLACE_MCP_LOG_LEVEL=INFO
SOLACE_METRICS_ENABLED=true
